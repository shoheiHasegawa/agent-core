(version 1)

;; ============================================================================
;; You_Inc Worker Least-Privilege Seatbelt Profile (Issue #2)
;; WHY: プロンプト上の禁止事項（性善説）に頼らず、OSカーネルレベル（macOS sandbox-exec）で
;;      機密情報の読み取り遮断・Worktree外への書き込み遮断・外部通信遮断を物理強制するため。
;; ============================================================================

;; 1. ベースライン: プロセス実行・システムライブラリ読取を許可し、危険な操作を後続ルールで遮断
(allow default)

;; 2. ネットワーク隔離: 外部IPへの通信・データ持ち出しを遮断し、ローカルループバックのみ許可 ([SB-05])
(deny network-outbound (remote ip))
(allow network-outbound (remote ip "localhost:*"))

;; 3. ファイル書き込み遮断: デフォルトで全領域への書き込みを禁止し、指定Worktree/Scratch/Cacheのみ許可 ([SB-01], [SB-08])
(deny file-write*)
(allow file-write*
  (subpath (param "ALLOWED_WORKTREE"))
  (subpath (param "ALLOWED_SCRATCH"))
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath (param "UV_CACHE_DIR"))
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/dtracehelper")
)

;; 4. 機密ファイル完全遮断 (Deny All Read/Write):
;;    ※ allow file-write* より後に配置することで、仮に ALLOWED_WORKTREE 内に機密ファイルが存在しても
;;      Seatbelt の後勝ち評価により Read/Write の両方を確実に Operation not permitted で拒否する ([SB-07])
(deny file-read-data file-write*
  (regex
    #"(^|/)(secret\.env|token\.json|credentials\.json|client_secret\.json)$"
    #"\.(pem|key)$"
  )
)
